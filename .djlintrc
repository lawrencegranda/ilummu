{
  "blank_line_after_tag": "endblock,endfor,endif",
  "blank_line_before_tag": "block,for,if",
  "line_break_after_multiline_tag": true,
  "use_gitignore": true,
  "ignore": "H021,H014",
  "format_css": true,
  "format_js": true,
  "indent": 4,
  "max_line_length": 120,
  "profile": "jinja",
  "max_attribute_length": 120,
  "format_attribute_template_tags": true,
  "close_void_tags": true,
  "max_blank_lines": 1
}