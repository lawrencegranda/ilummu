{% extends "bases/layout.jinja" %}

{% block title %}
  Forgot Password
{% endblock title %}

{% block javascript %}
  {{ super() }}
  <script>
  var errorMsg;

  // Function to reset error messages
  const reset = () => {
    errorMsg.text("");
    errorMsg.hide();
  };

  // Function to display error messages
  const showError = (msg) => {
    console.log(msg);
    errorMsg.text(msg);
    errorMsg.show();
  };

  // Ensure the document is ready before executing the script
  $(document).ready(() => {
    errorMsg = $("#error-msg");
    reset();
  });

  function handleSuccess(response) {
    $("#forgot-text").html("Email sent! Check your inbox for a reset link.");
    $(".signup-middle").hide();
    $("#forgot-button").hide();
    $("#forgot-button").prop("disabled",true);
  }

  function handleError(str) {
      return function (error) {
          $("#forgot-button").prop("disabled",false);
          
          let error_msg = getErrorResponse(error);

          if (!error_msg) {
            error_msg = "An error occurred during " + str + ". Please try again.";
          }

          showError(error_msg);
      }
  }

  $(document).ready(() => {
    errorMsg = $("#error-msg");

    // Form submission event handler for login form
    $("#forgot-form").on("submit", function (event) {
      event.preventDefault(); // Prevent default form submission
      reset();

      $("#forgot-button").prop("disabled",true);

      var netid = $("#signup-email").val().trim();
      if (!netid) {
        showError("Provide a valid NetID.");
        return;
      } else if (netid.includes(' ')) {
        showError("NetID cannot contain whitespace.");
        return;
      }
      // If validation passes, format the data
      var data = {
        email: netid + "@cornell.edu",
      };

      // Send the data via AJAX POST request
      $.ajax({
        url: '{{url_for("backend.user.reset_email")}}',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: handleSuccess,
        error: handleError("forgot password"),
      });
    });
  });

  </script>
{% endblock javascript %}

{% block headers %}
  <style>
      .footer {
          display: none;
      }

      body {
          background-color: var(--blue--base);
      }
  </style>
{% endblock headers %}

{% block content %}
  <div class="signup-wrapper">
    <div class="signup-container">
      <form class="signup-body" id="forgot-form" method="post">
        <div class="signup-top">
          <div class="logo-wrapper">
            <div class="signup-logo">
              <a class="brand" href='{{ url_for("frontend.home") }}'>
                <img class="image brand-image"
                     src="{{ url_for('static', filename='logo.svg') }}"
                     alt=""
                     width="auto"
                     height="auto" />
              </a>
              <div class="brand-name" onclick="location.href='/home';">
                ilummu
              </div>
            </div>
            <p class="made-students">
              Made by <strong style="color: var(--red)">Cornell</strong> Students
            </p>
          </div>
          <p class="signup-title">
            Forgot your password?
          </p>
          <p id="forgot-text" style="text-align: center;">
            No worries! Just give us your email and we will send you a password reset link.
          </p>
        </div>
        <div class="signup-middle">
          <div class="signup-email-box">
            <input id="signup-email"
                   type="text"
                   placeholder="netid"
                   autocomplete="off"
                   required />
            <span class="signup-email-cornell">@cornell.edu</span>
          </div>
          <p id="error-msg">
          </p>
        </div>
        <div class="signup-bottom">
          <button id="forgot-button"
                  form="forgot-form"
                  type="submit"
                  class="btn btn-primary"
                  type="button">
            Send Email
          </button>
          <div class="signup-login">
            Do not have an account? <a href='{{ url_for("frontend.signup", next_url=next_url, http_method=http_method) }}'>Sign Up</a>
            <br />
            Continue as a <a href='{{ url_for("frontend.dashboard") }}'>Guest</a>
          </div>
        </div>
      </form>
    </div>
  </div>
{% endblock content %}

{% block footer %}
{% endblock footer %}
