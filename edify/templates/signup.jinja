{% extends "bases/layout.jinja" %}

{% if login == true %}
  {% set login = true %}
{% else %}
  {% set login = false %}
{% endif %}

{% block title %}

  {% if login == true %}
    Log In
  {% else %}
    Sign Up
  {% endif %}

{% endblock title %}

{% block javascript %}
  {{ super() }}
  <script>
  var errorMsg;

  // Function to reset error messages
  const reset = () => {
    errorMsg.text("");
    errorMsg.hide();
  };

  // Function to display error messages
  const showError = (msg) => {
    console.log(msg);
    errorMsg.text(msg);
    errorMsg.show();
  };

  // Ensure the document is ready before executing the script
  $(document).ready(() => {
    errorMsg = $("#error-msg");
    reset();
  });

  function handleSuccess(response) {
      // Handle success

      let http_method = "{{ http_method | default('GET') }}"
      let next_url = "{{ next_url }}";

      if (http_method === "POST") {
          $.ajax({
              url: next_url,
              type: 'POST',
              success: function (response) {
                window.location.href = '{{url_for("frontend.dashboard")}}';
                return;
              },
              error: async function (error) {
                console.log(error)
                // Handle error (e.g., display error message)
                showError("An error occurred cresting a question. Please create it later.");
                await new Promise(resolve => setTimeout(resolve, 2000));
                showError("Redirecting...");
                await new Promise(resolve => setTimeout(resolve, 2000));
                window.location.href = '{{url_for("frontend.dashboard")}}';
              }
                });
          return
      }

      window.location.href = next_url;
      return;
  }

  {% if login == false %}
  // Conditional for signup form
  $(document).ready(() => {
    const phoneInputField = document.querySelector("#signup-phone");
    const phoneInput = window.intlTelInput(phoneInputField, {
      onlyCountries: ["us"],
      initialCountry: "us",
      nationalMode: true,
      separateDialCode: true,
      hiddenInput: () => ({
        phone: "full_phone",
        country: "country_code"
      }),
      utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
    });

    const errorMap = ["invalid", "invalid country code", "too short", "too long", "invalid"];
    errorMsg = $("#error-msg");

    // Form submission event handler for signup form
    $("#signup-form").on("submit", function (event) {
      event.preventDefault(); // Prevent default form submission
      reset();

      var netid = $("#signup-email").val().trim();
      if (!netid) {
        showError("NetID is required for email.");
        return;
      } else if (netid.length >= 7) {
        showError("NetID is too long.");
        return;
      } else if (netid.length < 3) {
        showError("NetID is too short.");
        return;
      } else if (netid.includes(' ')) {
        showError("NetID cannot contain whitespace.");
        return;
      }

      var phone = $("#signup-phone").val().trim();
      if (!phone) {
        showError("Phone number is required.");
        return;
      } else if (!phoneInput.isValidNumber()) {
        const errorCode = phoneInput.getValidationError();
        const msg = errorMap[errorCode] || "Invalid";
        showError("Phone number is " + msg);
        return;
      }

      var gradyear = parseInt($("#signup-grade").val().trim());
      if (!gradyear) {
        showError("Graduation year is required.");
        return;
      } else if (gradyear < 1900 || gradyear > 2050) {
        showError("Invalid graduation year.");
        return;
      }

      var major = $('#signup-major').val().trim();
      if ($('option[value="' + major + '"]').length == 0) {
        showError("Invalid major, select from the list.");
        return;
      }

      var password = $("#signup-password").val().trim();
      if (!password) {
        showError("Password is required.");
        return;
      } else if (password.length < 8) {
        showError("Password must be at least 8 characters long.");
        return;
      }

      var remember = $("#signup-remember-box").prop("checked");
      console.log(remember);

      // If validation passes, format the data
      var data = {
        email: netid + "@cornell.edu",
        phone: phoneInput.getNumber(),
        password: password,
        major: major,
        graduation: gradyear + "-05-30", // Assuming May 30th as a placeholder date
        remember: remember,
      };

      // Send the data via AJAX POST request
      $.ajax({
        url: '{{url_for("backend.user.signup")}}',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: handleSuccess,
        error: function (error) {
          console.log(error)
          // Handle error (e.g., display error message)
          try {
            showError(error['responseJSON']['errors']);
          } catch (e) {
            showError("An error occurred during signup. Please try again.");
          }
        }
      });
    });
  });

  {% else %}
  // Conditional for login form
  $(document).ready(() => {
    errorMsg = $("#error-msg");

    // Form submission event handler for login form
    $("#login-form").on("submit", function (event) {
      event.preventDefault(); // Prevent default form submission
      reset();

      var netid = $("#signup-email").val().trim();
      if (!netid) {
        showError("NetID is required for email.");
        return;
      } else if (netid.length >= 7) {
        showError("NetID is too long.");
        return;
      } else if (netid.length < 3) {
        showError("NetID is too short.");
        return;
      } else if (netid.includes(' ')) {
        showError("NetID cannot contain whitespace.");
        return;
      }

      var password = $("#signup-password").val().trim();
      if (!password) {
        showError("Password is required.");
        return;
      } else if (password.length < 8) {
        showError("Password must be at least 8 characters long.");
        return;
      }

      var remember = $("#signup-remember-box").prop("checked")
      console.log(remember)

      // If validation passes, format the data
      var data = {
        email: netid + "@cornell.edu",
        password: password,
        remember: remember,
      };

      // Send the data via AJAX POST request
      $.ajax({
        url: '{{url_for("backend.user.login")}}',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: handleSuccess,
        error: function (error) {
          console.log(error)
          // Handle error (e.g., display error message)
          try {
            showError(error['responseJSON']['errors']);
          } catch (e) {
            showError("An error occurred during login. Please try again.");
          }
        }
      });
    });
  });
  {% endif %}

  </script>
{% endblock javascript %}

{% block head %}
  {{ super() }}
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
{% endblock head %}

{% block headers %}
  <style>
      .footer {
          display: none;
      }

      body {
          background-color: var(--blue--base);
      }
  </style>
{% endblock headers %}

{% block content %}
  <div class="signup-wrapper">
    <div class="signup-container">
      <form class="signup-body"
            id="{{ 'signup-form' if login == false else 'login-form' }}"
            method="post">
        <div class="signup-top">
          <div class="logo-wrapper">
            <div class="signup-logo">
              <a class="brand" href='{{ url_for("frontend.home") }}'>
                <img class="image brand-image"
                     src="{{ url_for('static', filename='logo.svg') }}"
                     alt=""
                     width="auto"
                     height="auto" />
              </a>
              <div class="brand-name" onclick="location.href='/home';">
                Edify
              </div>
            </div>
            <p class="made-students">
              Made by <strong style="color: var(--red)">Cornell</strong> Students
            </p>
          </div>
          <p class="signup-title">

            {% if login == true %}
              Welcome Back!
            {% else %}
              Create Account
            {% endif %}
          </p>
        </div>
        <div class="signup-middle">
          <div class="signup-email-box">
            <input id="signup-email"
                   type="text"
                   placeholder="netid"
                   autocomplete="off"
                   required />
            <span class="signup-email-cornell">@cornell.edu</span>
          </div>

          {% if login == false %}
            <input id="signup-phone" type="tel" name="phone" required />
            <input id="signup-major"
                   list="majors-list"
                   placeholder="Major"
                   autocomplete="off"
                   required />
            <datalist id="majors-list">

              {% for major in majors %}
                <option value="{{ major['name'] }}" />
              {% endfor %}

            </datalist>
            <input id="signup-grade"
                   type="number"
                   min="1900"
                   max="2099"
                   step="1"
                   placeholder="Graduation Year (ex.: 2024)"
                   autocomplete="off"
                   required />
          {% endif %}

          <input id="signup-password"
                 type="password"
                 autocomplete="off"
                 minlength="8"
                 placeholder="Password"
                 required />
          <p id="error-msg">
          </p>
        </div>
        <div class="signup-bottom">
          <div class="signup-pair">
            <div class="signup-remember">
              <input type="checkbox" id="signup-remember-box" />
              <p class="signup-remember-text">
                Remember Me
              </p>
            </div>

            {% if login == true %}
              <p class="signup-forgot">
                <a href='{{ url_for("frontend.signup") }}'>Forgot Password?</a>
              </p>
            {% endif %}

          </div>

          {% if login == false %}
            <div class="signup-terms">
              <input type="checkbox" id="signup-terms-box" required />
              <p class="signup-terms-text">
                I accept to display my contact information to tutors when I accept their offers. I also agree to receiving
                emails and text messages from Edify.
              </p>
            </div>
          {% endif %}

          {% if login == false %}
            <button id="signup-button"
                    form="signup-form"
                    type="submit"
                    class="btn btn-primary"
                    type="button">
              Sign Up
            </button>
          {% else %}
            <button id="signup-button"
                    form="login-form"
                    type="submit"
                    class="btn btn-primary"
                    type="button">
              Log In
            </button>
          {% endif %}

          <div class="signup-login">

            {% if login == false %}
              Already have an account? <a href='{{ url_for("frontend.login") }}'>Log In</a>
            {% else %}
              Do not have an account? <a href='{{ url_for("frontend.signup") }}'>Sign Up</a>
            {% endif %}

            <br />
            Continue as a <a href='{{ url_for("frontend.dashboard") }}'>Guest</a>
          </div>
        </div>
      </form>
    </div>
  </div>
{% endblock content %}

{% block footer %}
{% endblock footer %}
