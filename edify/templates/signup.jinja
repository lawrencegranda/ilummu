{% extends "bases/layout.jinja" %}
{% set http_method = http_method | default('GET') %}
{% set next_url = next_url | default(url_for('frontend.dashboard')) %}

{% if login == true %}
    {% set login = true %}
{% else %}
    {% set login = false %}
{% endif %}

{% block title %}

    {% if login == true %}
        Log In
    {% else %}
        Sign Up
    {% endif %}

{% endblock title %}

{% block javascript %}
    {{ super() }}
    <script>
  var errorMsg;

  // Add password requirement checks
  const passwordRequirements = {
    length: false,
    lowercase: false,
    uppercase: false,
    number: false,
    special: false
  };

  function updatePasswordRequirements(password) {
    if (!password) {
      $('.password-requirements').hide();
      return;
    }
    
    $('.password-requirements').show();
    
    passwordRequirements.length = password.length >= 8;
    passwordRequirements.lowercase = /[a-z]/.test(password);
    passwordRequirements.uppercase = /[A-Z]/.test(password);
    passwordRequirements.number = /[0-9]/.test(password);
    passwordRequirements.special = /[!@#$%^&*(),.?":{}|<>]/.test(password);

    // Update the visibility of requirements
    $('#req-length').toggle(!passwordRequirements.length);
    $('#req-lowercase').toggle(!passwordRequirements.lowercase);
    $('#req-uppercase').toggle(!passwordRequirements.uppercase);
    $('#req-number').toggle(!passwordRequirements.number);
    $('#req-special').toggle(!passwordRequirements.special);
    
    // Hide the container if all requirements are met
    if (Object.values(passwordRequirements).every(req => req)) {
      $('.password-requirements').hide();
    }
  }

  // Function to reset error messages
  const reset = () => {
    errorMsg.text("");
    errorMsg.hide();
  };

  // Function to display error messages
  const showError = (msg) => {
    console.log(msg);
    errorMsg.text(msg);
    errorMsg.show();
  };

  // Ensure the document is ready before executing the script
  $(document).ready(() => {
    errorMsg = $("#error-msg");
    reset();
  });

  function handleSuccess(response) {
    // Handle success
    document.title = "Redirecting...";
    window.location.href = '{{ url_for("frontend.redirect_handler", next_url=next_url, http_method=http_method) }}';
  }

  function handleError(str) {
    return function (error) {
      let error_msg = getErrorResponse(error);

      if (!error_msg) {
        error_msg = "An error occurred during " + str + ". Please try again.";
      }

      showError(error_msg);
    }
  }

  {% if login == false %}
  // Conditional for signup form
  $(document).ready(() => {
    const phoneInputField = document.querySelector("#signup-phone");
    const phoneInput = window.intlTelInput(phoneInputField, {
      onlyCountries: ["us"],
      initialCountry: "us",
      nationalMode: true,
      separateDialCode: true,
      hiddenInput: () => ({
        phone: "full_phone",
        country: "country_code"
      }),
      utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
    });

    const errorMap = ["invalid", "invalid country code", "too short", "too long", "invalid"];
    errorMsg = $("#error-msg");

    // Hide requirements initially
    $('.password-requirements').hide();

    // Add password input listener
    $("#signup-password").on("input", function() {
      const password = $(this).val();
      updatePasswordRequirements(password);
    });

    // Form submission event handler for signup form
    $("#signup-form").on("submit", function (event) {
      event.preventDefault(); // Prevent default form submission
      reset();

      var netid = $("#signup-email").val().trim();
      if (!netid) {
        showError("NetID is required for email.");
        return;
      } else if (netid.length >= 7) {
        showError("NetID is too long.");
        return;
      } else if (netid.length < 3) {
        showError("NetID is too short.");
        return;
      } else if (netid.includes(' ')) {
        showError("NetID cannot contain whitespace.");
        return;
      }

      var phone = $("#signup-phone").val().trim();
      if (!phone) {
        showError("Phone number is required.");
        return;
      } else if (!phoneInput.isValidNumber()) {
        const errorCode = phoneInput.getValidationError();
        const msg = errorMap[errorCode] || "Invalid";
        showError("Phone number is " + msg);
        return;
      }

      var gradyear = parseInt($("#signup-grade").val().trim());
      if (!gradyear) {
        showError("Graduation year is required.");
        return;
      } else if (gradyear < 1900 || gradyear > 2050) {
        showError("Invalid graduation year.");
        return;
      }

      var major = $('#signup-major').val().trim();
      if ($('option[value="' + major + '"]').length == 0) {
        showError("Invalid major, select from the list.");
        return;
      }

      var password = $("#signup-password").val().trim();
      if (!password) {
        showError("Password is required.");
        return;
      } else if (!passwordRequirements.length || 
                 !passwordRequirements.lowercase || 
                 !passwordRequirements.uppercase || 
                 !passwordRequirements.number || 
                 !passwordRequirements.special) {
        showError("Password does not meet all requirements.");
        return;
      }

      var remember = $("#signup-remember-box").prop("checked");

      // If validation passes, format the data
      var data = {
        email: netid + "@cornell.edu",
        phone: phoneInput.getNumber(),
        password: password,
        major: major,
        graduation: gradyear + "-05-30", // Assuming May 30th as a placeholder date
        remember: remember,
      };

      // Send the data via AJAX POST request
      $.ajax({
        url: '{{url_for("backend.user.signup")}}',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function(data) {
          return handleSuccess(data);
        },
        error: handleError("signup"),
      });
    });
  });

  {% else %}
  // Conditional for login form
  $(document).ready(() => {
    errorMsg = $("#error-msg");

    // Form submission event handler for login form
    $("#login-form").on("submit", function (event) {
      event.preventDefault(); // Prevent default form submission
      reset();

      var netid = $("#signup-email").val().trim();
      if (!netid) {
        showError("NetID is required for email.");
        return;
      } else if (netid.length >= 7) {
        showError("NetID is too long.");
        return;
      } else if (netid.length < 3) {
        showError("NetID is too short.");
        return;
      } else if (netid.includes(' ')) {
        showError("NetID cannot contain whitespace.");
        return;
      }

      var password = $("#signup-password").val().trim();
      if (!password) {
        showError("Password is required.");
        return;
      } else if (password.length < 8) {
        showError("Password must be at least 8 characters long.");
        return;
      }

      var remember = $("#signup-remember-box").prop("checked")

      // If validation passes, format the data
      var data = {
        email: netid + "@cornell.edu",
        password: password,
        remember: remember,
      };

      // Send the data via AJAX POST request
      $.ajax({
        url: '{{url_for("backend.user.login")}}',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: handleSuccess,
        error: handleError("login"),
      });
    });
  });
  {% endif %}

    </script>
{% endblock javascript %}

{% block head %}
    {{ super() }}
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
{% endblock head %}

{% block headers %}
    <style>
        :root {
            --error-red: #dc3545;
        }

        .footer {
            display: none;
        }

        body {
            background-color: var(--blue--base);
        }

        .password-requirements {
            font-size: 0.9em;
            color: #666;
            margin: 10px 0;
            margin-bottom: 0px;
            padding: 0 15px;
        }

        .password-requirements ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .password-requirements li {
            position: relative;
            padding-left: 20px;
            margin: 2px 0;
            color: var(--error-red);
        }

        .password-requirements li::before {
            content: '✕';
            position: absolute;
            left: 0;
            color: var(--error-red);
        }

        #error-msg {
            color: var(--error-red);
        }
    </style>
{% endblock headers %}

{% block content %}
    <div class="signup-wrapper">
        <div class="signup-container">
            <form class="signup-body"
                  id="{{ 'signup-form' if login == false else 'login-form' }}"
                  method="post">
                <div class="signup-top">
                    <div class="logo-wrapper">
                        <div class="signup-logo">
                            <a class="brand" href='{{ url_for("frontend.home") }}'>
                                <img class="image brand-image"
                                     src="{{ url_for('static', filename='logo.svg') }}"
                                     alt=""
                                     width="auto"
                                     height="auto" />
                            </a>
                            <div class="brand-name" onclick="location.href='/home';">
                                ilummu
                            </div>
                        </div>
                        <p class="made-students">
                            Made by <strong style="color: var(--red)">Cornell</strong> Students
                        </p>
                    </div>
                    <p class="signup-title">

                        {% if login == true %}
                            Log In
                        {% else %}
                            Create Account
                        {% endif %}

                    </p>
                </div>
                <div class="signup-middle">
                    <div class="signup-email-box">
                        <input id="signup-email" type="text" placeholder="netid" autocomplete="off" required />
                        <span class="signup-email-cornell">@cornell.edu</span>
                    </div>

                    {% if login == false %}
                        <input id="signup-phone" type="tel" name="phone" required />
                        <input id="signup-major"
                               list="majors-list"
                               placeholder="Major"
                               autocomplete="off"
                               required />
                        <datalist id="majors-list">

                            {% for major in majors %}
                                <option value="{{ major['name'] }}" />
                            {% endfor %}

                        </datalist>
                        <input id="signup-grade"
                               type="number"
                               min="1900"
                               max="2099"
                               step="1"
                               placeholder="Graduation Year (ex.: 2024)"
                               autocomplete="off"
                               required />
                    {% endif %}

                    <input id="signup-password"
                           type="password"
                           autocomplete="off"
                           minlength="8"
                           placeholder="Password"
                           required />

                    {% if login == false %}
                        <div class="password-requirements">
                            <ul>
                                <li id="req-length">
                                    At least 8 characters
                                </li>
                                <li id="req-lowercase">
                                    One lowercase letter
                                </li>
                                <li id="req-uppercase">
                                    One uppercase letter
                                </li>
                                <li id="req-number">
                                    One number
                                </li>
                                <li id="req-special">
                                    One special character
                                </li>
                            </ul>
                        </div>
                    {% endif %}

                    <p id="error-msg">
                    </p>
                </div>
                <div class="signup-bottom">
                    <div class="signup-pair">
                        <div class="signup-remember">
                            <input type="checkbox" id="signup-remember-box" />
                            <p class="signup-remember-text">
                                Remember Me
                            </p>
                        </div>

                        {% if login == true %}
                            <p class="signup-forgot">
                                <a href='{{ url_for("frontend.forgot_password", next_url=next_url, http_method=http_method) }}'>Forgot Password?</a>
                            </p>
                        {% endif %}

                    </div>

                    {% if login == false %}
                        <div class="signup-terms">
                            <input type="checkbox" id="signup-terms-box" required />
                            <p class="signup-terms-text">
                                I accept to display my contact information to tutors when I accept their offers. I also agree to receiving
                                emails and text messages from ilummu.
                            </p>
                        </div>
                    {% endif %}

                    {% if login == false %}
                        <button id="signup-button"
                                form="signup-form"
                                type="submit"
                                class="btn btn-primary"
                                type="button">
                            Sign Up
                        </button>
                    {% else %}
                        <button id="signup-button"
                                form="login-form"
                                type="submit"
                                class="btn btn-primary"
                                type="button">
                            Log In
                        </button>
                    {% endif %}

                    {% if login == false %}
                        <div class="signup-google">
                            <a class="btn btn-primary" href="{{ url_for('backend.oauth.login') }}">
                                {# djlint:off H006 #}
                                <img src="{{ url_for('static', filename='google.svg') }}" alt="Google Logo" />
                                {# djlint:on H006 #}
                                Sign Up with Google
                            </a>
                        </div>
                    {% else %}
                        <div class="signup-google">
                            <a class="btn btn-primary" href="{{ url_for('backend.oauth.login') }}">
                                {# djlint:off H006 #}
                                <img src="{{ url_for('static', filename='google.svg') }}" alt="Google Logo" />
                                {# djlint:on H006 #}
                                Sign In with Google
                            </a>
                        </div>
                    {% endif %}

                    <div class="signup-login">

                        {% if login == false %}
                            Already have an account? <a href='{{ url_for("frontend.login", next_url=next_url, http_method=http_method) }}'>Log In</a>
                        {% else %}
                            Do not have an account? <a href='{{ url_for("frontend.signup", next_url=next_url, http_method=http_method) }}'>Sign Up</a>
                        {% endif %}

                        <br />
                        Continue as a <a href='{{ url_for("frontend.dashboard") }}'>Guest</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock content %}

{% block footer %}
{% endblock footer %}
