{% extends "bases/layout.jinja" %}
{% set increment = 2 %}

{% block title %}
  Question
{% endblock title %}

{% block navbar %}
  {% include "bases/navbar-logged.jinja" if user else "bases/navbar-not-logged.jinja" %}
{% endblock navbar %}

{% block top %}
  {% include "bases/create-question.jinja" %}
{% endblock top %}

{% block javascript %}
  {{ super() }}

  {% if user and not question.solved and not question.is_author and not question.offer_made %}
    <script>
      function makeOffer(value) {
          // Define the data to be sent in the request
          const data = {
              question_id: {{ question.id }},
              price: value,
          };

          $.ajax({
              url: '{{ url_for("backend.offer.create_offer") }}',
              type: 'POST',
              contentType: 'application/json',
              data: JSON.stringify(data),
              success: function (response) {
                  // Reload the page
                  location.reload()
              },
              error: function(xhr, status, error) {
                  console.error('Error: ', error);
              }
          });
      }

       $(document).ready(function () {
          $("#button-agree-offer").on("click", function () {
              value = {{ question.price }}
              makeOffer(value)
          });

          $("#button-make-offer").on("click", function () {
              value = $("#offer-fare").val()
              makeOffer(value)          
          });
       });
    </script>
  {% endif %}

  {% if user and not question.solved and not question.is_author
    and question.offer_made and (not question.offer_made.status == "ACCEPTED") %}
    <script>
      function revokeOffer() {
          $.ajax({
              url: '{{ url_for("backend.offer.delete_offer", id_offer=question.offer_made.id) }}',
              type: 'DELETE',
              success: function (response) {
                  // Reload the page
                  location.reload()
              },
              error: function(xhr, status, error) {
                  console.error('Error: ', error);
              }
          });
      }

       $(document).ready(function () {
          $("#revoke-offer").on("click", function () {
              revokeOffer()
          });
       });
    </script>
  {% endif %}

  {% if user and not question.solved and question.is_author and (not question.offer_accepted) %}
    <script>
      // Calculate bounds
      const lowestValue = {{ question.original_price }};
      const highestValue = 3 * lowestValue;

      // Set the increment value
      const increment = Math.abs({{ increment }});

      // Send request to change question price
      function changePrice(value) {
          // Define the data to be sent in the request
          const data = {
              price: value,
          };

          let url = '{{ url_for("backend.question.change_price", id_question=question.id) }}'

          $.ajax({
              url: url,
              type: 'PUT',
              contentType: 'application/json', // Specify content type as JSON
              data: JSON.stringify(data), // Send data as a JSON string
              success: function (response) {
                  // Reload the page
                  location.reload()
              },
              error: function(xhr, status, error) {
                  console.error('Error: ', error);
              }
          });
      }

      // Function to update the display price and buttons
      function displayPrice() {          
          // Retrieve the current value
          let value =  parseFloat($("#bid-value").data('value'));

          if (value + increment > highestValue) {
              if (!$("#btn-bid-raise").hasClass('disabled')) {
                  $("#btn-bid-raise").toggleClass('disabled');
              }
          } else {
              if ($("#btn-bid-raise").hasClass('disabled')) {
                  $("#btn-bid-raise").toggleClass('disabled');
              }
          }

          if (value - increment < lowestValue) {
              if (!$("#btn-bid-lower").hasClass('disabled')) {
                  $("#btn-bid-lower").toggleClass('disabled');
              }
          } else {
              if ($("#btn-bid-lower").hasClass('disabled')) {
                  $("#btn-bid-lower").toggleClass('disabled');
              }
          }
      }

      // Function to update the display price and return the new price
      function updatePrice(button) {
          // Retrieve delta and current value
          let delta = parseFloat(button.data('value'));
          let currentValue = parseFloat($("#bid-value").data('value'));

          // Check if the button is disabled
          if (button.prop('disabled') || button.hasClass('disabled')) {
              return currentValue;
          }

          // Calculate the new value
          let newValue = currentValue + delta;

          // Check bounds
          if (newValue > highestValue) {
              newValue = highestValue;
          } else if (newValue < lowestValue) {
              newValue = lowestValue;
          }

          // Update the data-value attribute with the new value
          $("#bid-value").data('value', newValue);
          
          // Update the content to display the new value in dollars with two decimal places
          $("#bid-value").text('$' + newValue.toFixed(2));
        
          // Display the buttons
          displayPrice();
      }

      $(document).ready(function () {
          displayPrice();

          $("#btn-bid-lower").on("click", function () {
              updatePrice($(this));
          });

          $("#btn-bid-raise").on("click", function () {
              updatePrice($(this));
          });

          $("#btn-update-price").on("click", function () {
              changePrice($("#bid-value").data('value'));
          });
       });
    </script>
  {% endif %}

  {% if user and not question.solved and question.is_author and (not question.offer_accepted) %}
    <script>
      function cancelQuestion() {
          $.ajax({
              url: '{{  url_for("backend.question.delete_question", id_question=question.id) }}',
              type: 'DELETE',
              success: function (response) {
                  // Redirect to dashboard
                  window.location.href = '{{ url_for("frontend.dashboard") }}'
              },
              error: function(xhr, status, error) {
                  console.error('Error: ', error);
                  location.reload()
              }
          });
      }

       $(document).ready(function () {
          $("#btn-bid-cancel").on("click", function () {
              cancelQuestion()
          });
       });
    </script>
  {% endif %}

{% endblock javascript %}

{% block content %}
  <div class="{{ 'container main-content logged' if user else 'container main-content' }}">
    <div class="question-wrapper">
      <div class="question-body">
        <div class="question-top">
          <div class="question-left">
            <div id="question-user-profile">
              <img src="https://robohash.org/{{ question.user.username }}"
                   alt="Avatar"
                   class="avatar"
                   height="auto"
                   width="auto" />
            </div>
            <div class="question-user">
              <p class="question-user-name">
                {{ question.user.username }}
              </p>
              <p class="question-user-info">
                {{ question.user.major }} • {{ question.user.year }}
              </p>
            </div>
          </div>
          <div class="question-right">
            <p id="question-date">
              {{ question.time_ago }}
            </p>
            <div class="question-labels">
              <div class="question-price">
                ${{ '%.2f' % question.price | float }}
              </div>

              {% if question.solved %}
                <p class="question-status solved">
                  solved
                </p>
              {% else %}
                <p class="question-status unsolved">
                  unsolved
                </p>
              {% endif %}

            </div>
          </div>
        </div>
        <div class="question-bottom">
          {% if question.image_url %}
            <div class="question-image">
              <img src="{{ question.image_url }}" alt="Question Image" class="question-img" width="auto" height="auto" />
            </div>
          {% endif %}
          <p class="question-class">
            {{ question.course_code }}: {{ question.course_name }}
          </p>
          <p class="question-info">
            {{ question.solve_time }} solve time • {{ question.method }}
          </p>
          <p class="question-text">
            {{ question.request }}
          </p>
        </div>
      </div>

      {% if not user %}
        <div class="separator">
        </div>
        <p class="question-statement">
          Please <a href='{{ url_for("frontend.signup") }}'>sign up</a> to see more details or interact with this
          question.
        </p>
      {% else %}

        {% if question.is_author %}
          {% if question.offer_accepted %}
            <div class="separator">
            </div>
            <div class="accepted-offer-wrapper">
              <div class="accepted-offer">
                <div class="offer-left">
                  <div class="offer-user-profile">
                    <img src="https://robohash.org/{{ question.offer_accepted.user.username }}"
                         alt="Avatar"
                         class="avatar"
                         height="100"
                         width="100" />
                  </div>
                  <div class="question-user">
                    <p class="question-user-name">
                      {{ question.offer_accepted.user.username }}
                      &nbsp;
                      <span class="rating">

                        {% if not question.offer_accepted.rating %}
                        {% elif question.offer_accepted.rating >= 3 %}
                          {{ '%.1f' % question.offer_accepted.rating }}
                          <span class="glyphicon glyphicon-star"></span>
                        {% else %}
                          {{ '%.1f' % question.offer_accepted.rating }}
                          <span class="glyphicon glyphicon-star-empty"></span>
                        {% endif %}

                      </span>
                    </p>
                    <p class="question-user-info">
                      {{ question.offer_accepted.user.major }} • {{
                      question.offer_accepted.user.year }}
                    </p>
                  </div>
                </div>
                <div class="accepted-offer-price">
                  Pay ${{ '%.2f' % question.offer_accepted.amount | float }}
                </div>
              </div>
              <p class="accepted-offer-statement">
                Please contact the tutor through this phone number:
              </p>
              <p class="accepted-offer-phone">
                {{ question.offer_accepted.user.phone }}
              </p>
              <p class="accepted-offer-message">
                ** Arrange payment on your own **
              </p>
            </div>
          {% else %}

            {% if question.solved %}
              <div class="separator">
              </div>
              <p class="question-statement">
                No offers received.
              </p>
            {% else %}
              {% include "bases/question-author-offer-list.jinja" %}
              <div class="bid-wrapper">
                <div class="bid-body">
                  <p id="question-wait-header" class="offer-title">
                    Looking For Tutors...
                  </p>
                  <div id="bid-progress" onload="move_progress()">
                    <div id="bid-bar">
                    </div>
                  </div>
                  <p class="bid-label">
                    Your Offer:
                  </p>
                  <div class="bid-update-buttons">
                    <button id="btn-bid-lower"
                            data-value="-{{ increment }}"
                            class="btn btn-primary btn-bid-update disabled"
                            type="button">
                      -${{ increment }}
                    </button>
                    <p id="bid-value" data-value="{{ '%.2f' % question.price | float }}">
                      ${{ '%.2f' % question.price | float }}
                    </p>
                    <button id="btn-bid-raise"
                            data-value="{{ increment }}"
                            class="btn btn-primary btn-bid-update"
                            type="button">
                      +${{ increment }}
                    </button>
                  </div>
                  <button id="btn-update-price" class="btn btn-primary" type="button">
                    Update Price
                  </button>
                  <button id="btn-bid-cancel" class="btn btn-dark" type="button">
                    Cancel Request
                  </button>
                  <p class="bid-tip">
                    Tip: if no one is accepting the offer, then probably current price is not attractive.
                    <br />
                    We recommend raising your price.
                  </p>
                </div>
              </div>
            {% endif %}
          {% endif %}

        {% else %}
          {% import "macros/offer-declined-macro.jinja" as macro %}

          {% if question.offer_made and question.offer_made.status == "ACCEPTED" %}
            <div class="separator">
            </div>
            <div class="accepted-offer-wrapper">
              <div class="accepted-offer">
                <div class="offer-left">
                  <div class="offer-user-profile">
                    <img src="https://robohash.org/{{ question.user.username }}"
                         alt="Avatar"
                         class="avatar"
                         height="100"
                         width="100" />
                  </div>
                  <div class="question-user">
                    <p class="question-user-name">
                      {{ question.user.username }}
                    </p>
                    <p class="question-user-info">
                      {{ question.user.major }} • {{ question.user.year | int }}
                    </p>
                  </div>
                </div>
                <div class="accepted-offer-price">
                  Earn ${{ '%.2f' % question.offer_made.amount | float }}
                </div>
              </div>
              <p class="accepted-offer-statement">
                Please contact the student through this phone number:
              </p>
              <p class="accepted-offer-phone">
                {{ question.user.phone }}
              </p>
              <p class="accepted-offer-message">
                ** Arrange payment on your own **
              </p>
            </div>
          {% elif question.solved %}

            {% if question.offer_made %}
              {{ macro.declined_offer("You can find another question.") }}
            {% else %}
            {% endif %}

          {% else %}

            {% if not question.offer_made %}
              <div class="offer-wrapper">
                <div class="offer-body">
                  <p class="offer-title">
                    Make an Offer!
                  </p>
                  <p class="offer-statement">
                    For what price will you help this student?
                  </p>
                  <div class="offer-pair">
                    <p class="make-offer-label">
                      Your fare:
                    </p>
                    <input type="range"
                           class="form-range"
                           id="offer-fare"
                           value="{{ question.price }}"
                           min="{{ question.price }}"
                           max="{{ 2 * question.price }}"
                           step="0.25"
                           oninput="this.nextElementSibling.value = '$' + parseFloat(this.value).toFixed(2)" />
                    <output class="offer-value">${{ '%.2f' % question.price | float }}</output>
                  </div>
                  <div class="offer-pair">
                    <button id="button-agree-offer"
                            class="btn btn-primary btn-offer"
                            type="button">
                      Accept for ${{ '%.2f' % question.price | float }}
                    </button>
                    <button id="button-make-offer" class="btn btn-dark btn-offer" type="button">
                      Counter ${{ '%.2f' % question.price | float }}
                    </button>
                  </div>
                </div>
              </div>
            {% elif question.offer_made.status == "DECLINED" %}
              {{ macro.declined_offer("You can make another offer or find another question.") }}
            {% else %}
              <div class="separator">
              </div>
              <div class="double-col">
                <p class="question-statement wait-offer">
                  Waiting for the student to accept your offer for
                  <strong>${{ '%.2f' % question.offer_made.amount | float }}</strong>.
                </p>
                <button id="revoke-offer" class="btn btn-primary">
                  Revoke Offer
                </button>
              </div>
            {% endif %}
          {% endif %}
        {% endif %}
      {% endif %}

    </div>
  </div>
{% endblock content %}
