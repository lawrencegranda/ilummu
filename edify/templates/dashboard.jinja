{% extends "bases/layout.jinja" %}

{% block title %}
  Dashboard
{% endblock title %}

{% block navbar %}
  {% include "bases/navbar-logged.jinja" if user else "bases/navbar-not-logged.jinja" %}
  <style>
      input#search-box {
          display: initial !important;
          pointer-events: initial !important;
      }
  </style>
{% endblock navbar %}

{% block top %}
  {% include "bases/add-button.jinja" %}
  {% include "bases/create-question.jinja" %}
{% endblock top %}

{% block javascript %}
  {{ super() }}
  <script>
      function getSelectedCategoryCountAndValues() {
          const container = $('.dashboard-menu-container');
          const selectedValues = [];

          console.log(container)

          if (container.length === 0 || container.css('display') === 'none') {
              // Get the option value from id="category-selector"
              const selector = $('#category-selector');
              if (selector.length > 0) {
                  selectedValues.push(selector.val());
              }
          } else {
              // Select all buttons with the 'category' class
              $('.category').each(function() {
                  if ($(this).hasClass('selected') && !$(this).is(':disabled')) {
                      selectedValues.push($(this).val());
                  }
              });
          }

          console.log(selectedValues)

          return selectedValues;
      }

      function loadQuestions(selectedValues, searchInput) {
          // Define the data to be sent in the request
          const data = {
              fields: selectedValues,
              search: searchInput,
          };

          $.ajax({
              url: '{{url_for("frontend.question_list")}}',
              method: 'GET',
              data: data,
              traditional: true, // Ensures proper handling of arrays
              success: function(response) {
                  // Process the response and update the question_list
                  $('#question_list').html(response);
              },
              error: function(xhr, status, error) {
                  console.error('Error fetching questions:', error);
              }
          });
      }

      function arraysAreEqual(arr1, arr2) {
          // Convert arrays to Sets
          const set1 = new Set(arr1);
          const set2 = new Set(arr2);

          // Check if the sizes of the sets are equal
          if (set1.size !== set2.size) {
              return false;
          }

          // Check if all elements in set1 are in set2
          for (const item of set1) {
              if (!set2.has(item)) {
                  return false;
              }
          }

          return true;
      }


      $(document).ready(function () {
          $(".category").not(".all-subjects").on("click", function () {
              // Toggle the selected class on the clicked category
              $(this).toggleClass("selected");

              // Remove the selected class from .all-subjects
              $(".all-subjects").removeClass("selected");

              // Select all elements with the .category class
              const categories = $(".category").not(".all-subjects");
    
              // Check if every .category element has the .selected class
              const selected = categories.filter(".selected");
              if (selected.length === categories.length) {
                  $(".category").removeClass("selected");
              }

              // Add the selected class to .all-subjects if no categories are selected
              const values = $(".category").filter(".selected")
              if (values.length === 0) {
                  $(".all-subjects").addClass("selected");
              }
          });

          $(".all-subjects").on("click", function () {
              $(".category").removeClass("selected");
              $(this).toggleClass("selected");
          });

          // Function to handle the common logic for all events
          function handleUpdate() {
              const values = getSelectedCategoryCountAndValues();

              // Get the value of the input field
              const inputValue = $('#search-box').val();

              // Pass both values and inputValue to the AJAX function
              loadQuestions(values, inputValue);
          }

          // Attach event handlers
          $('button.category').on('click', handleUpdate);
          $('#category-selector').on('change', handleUpdate);
          $('#search-box').on('input', function () {
              handleUpdate();
              console.log('1');
          });
      });
  </script>
{% endblock javascript %}

{% block content %}
  <div class="{{ 'container main-content logged' if user else 'container main-content' }}">
    <div class="dashboard-container">
      <div class="dashboard-menu-container">
        <div class="dashboard-menu">
          {#
          <div class="method-selector-container">
            <select name="method-selector" id="method-selector">
              <option value="any-method">Any Method</option>
              {% for method in methods %}
              <option value="{{method['value']}}">{{method['name']}}</option>
              {% endfor %}
            </select>
          </div>
#}
          <button class="btn category all-subjects selected" value="">
            All Questions
          </button>

          {% for subject in subjects %}
            <button class="btn category" value="{{ subject['value'] }}">
              {{ subject['name'] }}
            </button>
          {% endfor %}

        </div>
      </div>
      <div class="dashboard-menu-container-small">
        <div class="dashboard-menu-small">
          <select name="category-selector" id="category-selector">
            <option value="">
              All Questions
            </option>

            {% for subject in subjects %}
              <option value="{{ subject['value'] }}">
                {{ subject['name'] }}
              </option>
            {% endfor %}

          </select>
        </div>
        {#
        <div class="dashboard-menu-small">
          <select name="method-selector" id="method-selector">
            <option value="any-method">Any Method</option>
            {% for method in methods %}
            <option value="{{method['value']}}">{{method['name']}}</option>
            {% endfor %}
          </select>
        </div>
#}
      </div>
      <div id="question_list" class="grid">

        {% block question_list %}
          {{ question_list | safe }}
        {% endblock question_list %}

      </div>
    </div>
  </div>
{% endblock content %}
