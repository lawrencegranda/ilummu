{% extends "bases/layout.jinja" %}

{% block title %}
    Any person, any study, any time, any price.
{% endblock title %}

{% block navbar %}
    {% include "bases/navbar-logged.jinja" if user else "bases/navbar-not-logged.jinja" %}
    <style>
        input#search-box,
        #button-nav-question {
            display: none !important;
            pointer-events: none !important;
        }

        .navbar.logged {
            height: initial !important;
        }
    </style>
{% endblock navbar %}

{% block content %}
    <div class="container main-content landing-content">
        <div id="spacer1">
        </div>
        <div class="two-sides">
            <div class="home-background home-background1">
                <svg viewBox="0 0 20 10"
                     class="home-svg home-svg1"
                     preserveAspectRatio="none">
                    <polygon points="0,0 7,0 13,10 0,10 0,0" />
                </svg>
                <svg viewBox="0 0 10 20"
                     class="home-svg home-svg2"
                     preserveAspectRatio="none">
                    <polygon points="0,0 0,14 10,8 10,0 0,0" />
                </svg>
            </div>
            <div class="container-regular">
                <div class="header-content">
                    <h1 class="heading">
                        Get 1-1 Coursework Help
                        <br />
                        From College Peers at
                    </h1>
                    <h1 class="heading blue">
                        YOUR PRICE
                    </h1>
                </div>
                <div class="left-container">
                    <p class="paragraph left">
                        Ask questions <strong>anytime</strong> and get instant answers.
                        <br />
                        Or, help others and <strong>earn money</strong>.
                    </p>
                    <button id="home-start-now"
                            class="btn btn-primary"
                            onclick="location.href='/dashboard';">
                        Start Now
                    </button>
                </div>
            </div>
            <div class="home-image">
                <img src="{{ url_for('static', filename='home.svg') }}"
                     width="auto"
                     height="auto"
                     alt="" />
            </div>
        </div>
        <div id="instructions" class="three-columns-container row-flex">
            <div class="column third">
                <h5 class="center instructions-text">
                    Post Questions and Help Peers
                </h5>
                <div class="instructions-image">
                    <img src="{{ url_for('static', filename='dashboard-image.png') }}"
                         width="auto"
                         height="auto"
                         alt="" />
                </div>
            </div>
            <div class="column third center-column">
                <h5 class="center instructions-text">
                    Choose Offers to Save Money
                </h5>
                <div class="instructions-image">
                    <img src="{{ url_for('static', filename='offers-image.png') }}"
                         width="auto"
                         height="auto"
                         alt="" />
                </div>
            </div>
            <div class="column third">
                <h5 class="center instructions-text">
                    Answer and Earn Money
                </h5>
                <div class="instructions-image">
                    <img src="{{ url_for('static', filename='bid-image.png') }}"
                         width="auto"
                         height="auto"
                         alt="" />
                </div>
            </div>
        </div>
        <div id="home-create-wrapper">
            <div class="home-background home-background2">
                <svg viewBox="0 0 1440 320" class="home-svg" preserveAspectRatio="none">
                    <path d="M0,160L20,154.7C40,149,80,139,120,154.7C160,171,200,213,240,224C280,235,320,213,360,213.3C400,213,440,235,480,229.3C520,224,560,192,600,170.7C640,149,680,139,720,144C760,149,800,171,840,192C880,213,920,235,960,208C1000,181,1040,107,1080,80C1120,53,1160,75,1200,101.3C1240,128,1280,160,1320,170.7C1360,181,1400,171,1420,165.3L1440,160L1440,320L1420,320C1400,320,1360,320,1320,320C1280,320,1240,320,1200,320C1160,320,1120,320,1080,320C1040,320,1000,320,960,320C920,320,880,320,840,320C800,320,760,320,720,320C680,320,640,320,600,320C560,320,520,320,480,320C440,320,400,320,360,320C320,320,280,320,240,320C200,320,160,320,120,320C80,320,40,320,20,320L0,320Z">
                    </path>
                </svg>
            </div>
            <div class="home-background home-background3">
                <svg viewBox="0 0 10 10" class="home-svg" preserveAspectRatio="none">
                    <polygon points="0,0 0,10 10,10 10,0 0,0" />
                </svg>
            </div>
            {% include "bases/create-question-form.jinja" %}
        </div>
    </div>
{% endblock content %}
