{% set title = "Reset Password" %}
{% set title_text = "Reset Password" %}
{% set description_id = "reset-text" %}
{% set description_text = "" %}
{% set has_button = True %}
{% set button_id = "reset-button" %}
{% set button_text = "Set Password" %}
{% set form_id = "reset-form" %}
{% set form_disabled = False %}
{% extends "auth_template.jinja" %}
{% set http_method = http_method | default('GET') %}
{% set next_url = next_url | default(url_for('frontend.dashboard')) %}

{% block javascript %}
  {{ super() }}
  <script>
    var errorMsg;

    // Function to reset error messages
    const reset = () => {
      errorMsg.text("");
      errorMsg.hide();
    };

    // Function to display error messages
    const showError = (msg) => {
      console.log(msg);
      errorMsg.text(msg);
      errorMsg.show();
    };

    // Ensure the document is ready before executing the script
    $(document).ready(() => {
      errorMsg = $("#error-msg");
      reset();
    });

  function handleSuccess(response) {
      // Handle success
      document.title = "Redirecting...";
      window.location.href = '{{ url_for("frontend.redirect_handler", next_url=next_url, http_method=http_method) }}';
  }

    function handleError(str) {
        return function (error) {
            let error_msg = getErrorResponse(error);

            if (!error_msg) {
              error_msg = "An error occurred during " + str + ". Please try again.";
            }

            showError(error_msg);
        }
    }

    $(document).ready(() => {
      errorMsg = $("#error-msg");

      // Form submission event handler for login form
      $("#reset-form").on("submit", function (event) {
        event.preventDefault(); // Prevent default form submission
        reset();

        var password = $("#signup-password").val().trim();
        if (!password) {
          showError("Password is required.");
          return;
        } else if (password.length < 8) {
          showError("Password must be at least 8 characters long.");
          return;
        }
        
        // If validation passes, format the data
        var data = {
          password: password,
          token: '{{ token | default("") }}',
        };

        // Send the data via AJAX POST request
        $.ajax({
          url: '{{url_for("backend.user.reset_password")}}',
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify(data),
          success: handleSuccess,
          error: handleError("password reset"),
        });
      });
    });

  </script>
{% endblock javascript %}

{% block form_content %}
  <input id="signup-password"
         type="password"
         autocomplete="off"
         minlength="8"
         placeholder="Password"
         required />
{% endblock form_content %}

{% block additional_links %}
  <div class="signup-login">
    Is the link not working? <a href='{{ url_for("frontend.forgot_password") }}'>Try Again</a>
    <br />
    Remembered your password? <a href='{{ url_for("frontend.login", next_url=next_url, http_method=http_method) }}'>Log In</a>
  </div>
{% endblock additional_links %}
