<script>
  function acceptOffer(id){
      let url = '{{ url_for("backend.offer.accept_offer", offer_id="0") }}'.replace('0', id);

      $.ajax({
          url: url,
          type: 'POST',
          success: function (response) {
              // Reload the page
              location.reload()
          },
          error: function(xhr, status, error) {
              console.error('Error: ', error);
          }
      });
  } 
  
  function declineOffer(id){
      let url = '{{ url_for("backend.offer.decline_offer", offer_id="0") }}'.replace('0', id);
      
      $.ajax({
          url: url,
          type: 'POST',
          success: function (response) {
              // Reload the page
              location.reload()
          },
          error: function(xhr, status, error) {
              console.error('Error: ', error);
          }
      });
  } 
</script>
<div class="your-offers-wrapper">
    <p class="offer-title">
        Your Offers:
    </p>
    <div class="offer-list">

        {% if not question or not question.offers or question.offers | length == 0 %}
            <p class="question-statement">
                No offers available.
            </p>
        {% else %}

            {% for offer in question.offers %}
                <div class="offer">
                    <div class="offer-left">
                        <div class="offer-user-profile">
                            <img src="https://robohash.org/{{ offer['user']['username'] }}"
                                 alt="Avatar"
                                 class="avatar"
                                 width="auto"
                                 height="auto" />
                        </div>
                        <div class="question-user">
                            <p class="question-user-name">
                                {{ offer['user']['username'] }}
                                &nbsp;
                                <span class="rating">

                                    {% if offer['rating'] is not number %}
                                    {% elif offer['rating'] >= 3 %}
                                        {{ '%.1f' % offer['rating'] }}
                                        <span class="glyphicon glyphicon-star"></span>
                                    {% else %}
                                        {{ '%.1f' % offer['rating'] }}
                                        <span class="glyphicon glyphicon-star-empty"></span>
                                    {% endif %}

                                </span>
                            </p>
                            <p class="question-user-info">
                                {{ offer['user']['major'] }} • {{ offer['user']['year'] }}
                            </p>
                        </div>
                    </div>
                    <div class="offer-right">
                        <div class="question-price">
                            ${{ '%.2f' % offer['amount'] }}
                        </div>
                        <div class="offer-buttons">
                            <button id="btn-accept-offer"
                                    class="btn btn-my-offer"
                                    type="button"
                                    onclick="acceptOffer({{ offer['id'] }})">
                                accept
                            </button>
                            <button id="btn-decline-offer"
                                    class="btn btn-my-offer"
                                    type="button"
                                    onclick="declineOffer({{ offer['id'] }})">
                                decline
                            </button>
                        </div>
                    </div>
                </div>
            {% endfor %}

        {% endif %}

    </div>
</div>
