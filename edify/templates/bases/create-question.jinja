<script>
  var errorMsg

  // Function to reset error messages
  const reset =() => {
    errorMsg.text("");
    errorMsg.hide();
  };

  // Function to display error messages
  const showError = (msg) => {
    console.log(msg);
    errorMsg.text(msg);
    errorMsg.show();
  };

  // Ensure the document is ready before executing the script
  $(document).ready(() => {
    errorMsg = $("#error-msg");
    reset();
  });

  $(document).ready(()=> {

    // Form submission event handler for question form
    $("#create-question-form").on("submit", function (event) {
      event.preventDefault(); // Prevent default form submission
      reset();

      var class_code = $("#create-question-class-code").val().replace(' ', '').trim();
      if (!class_code) {
        showError("Class code is required.");
        return;
      } else if (class_code.length > 8) {
        showError("Class code is too long.");
        return;
      } else if (class_code.length < 6) {
        showError("Class code is too short.");
        return;
      }

      var class_name = $("#create-question-class-name").val().replace(/\s+/g, '').trim();
      if (!class_name) {
        showError("Class name is required.");
        return;
      } else if (class_name.length < 3) {
        showError("Class name is too short.");
        return;
      }

      var request_message = $("#create-question-textbox").val().replace(/[ \t]+/g, ' ').trim();
      if (!request_message) {
        showError("Fill out the textarea.");
        return;
      } else if (request_message.length < 50) {
        showError("Request is too short (minimum of 50 characters).");
        return;
      } else if (request_message.length > 5000) {
        showError("Request is too long (maximum of 5000 characters).");
        return;
      }

      var academic_field = $("#create-question-category").val().trim()
      if (!academic_field) {
        showError("Select a school from the options.");
        return;
      }

      var method = $("#create-question-method").val().trim()
      if (!method) {
        showError("Select a method from the options.");
        return;
      }

      var time = $("#create-question-solve-time").val().trim()
      if (!time) {
        showError("Select a time interval from the options.");
        return;
      }

      var price = parseFloat($("#create-question-price").val().trim());
      if (!price) {
        showError("A question price is required.");
        return;
      } else if (isNaN(price)) {
        showError("Please enter a valid price.");
        return;
      } else if (price < 2) {
        showError("$2.00 is the minimum price.");
        return;
      } else if (price > 100) {
        showError("$100.00 is the maximum price.");
        return;
      }

      // If validation passes, format the data
      var data = {
        class_code: class_code,
        class_name: class_name,
        request_message: request_message,
        academic_field: academic_field,
        method: method,
        solve_time: time,
        price: price,
      };

      // Send the data via AJAX POST request
      $.ajax({
        url: '{{url_for("backend.question.create_question")}}',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        success: function (response) {
          // Handle success (e.g., redirect to dashboard page)
          let element = $(".create-question-wrapper-dimensions");

          if (element.is(":visible"))
            setTimeout(function () {
              element.hide();
            }, 300);
          else element.show();
          return
        },
        error: function (error) {
          console.log(error)
          // Handle error (e.g., display error message)
          try {
            showError(error['responseJSON']['errors']);
          } catch (e) {
            showError("An error occurred during creation. Please try again.");
          }
        }
      });
    });
  });
</script>
<div class="create-question-wrapper-dimensions create-question-wrapper-background"
     style="display: none">
</div>
<div class="create-question-wrapper-dimensions create-question-wrapper"
     style="display: none">
  {% include "bases/create-question-container.jinja" %}
</div>
