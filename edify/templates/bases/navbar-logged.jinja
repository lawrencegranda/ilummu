<div class="navbar logged">
    <div class="container">
        <div class="navigation">
            <div class="navigation-left">
                <a class="brand" href='{{ url_for("frontend.dashboard") }}'>
                    <img class="image brand-image"
                         src="{{ url_for('static', filename='logo.svg') }}"
                         alt=""
                         width="auto"
                         height="auto" />
                </a>
                <div class="brand-name" onclick="location.href='/home';">
                    Edify
                </div>
            </div>
            <div class="navigation-center">
                <input type="text"
                       id="search-box"
                       placeholder="Search for a question..."
                       name="text"
                       autocomplete="off" />
            </div>
            <div class="navigation-right">
                <div class="navigation-button-wrap">
                    <button type="button" id="notification">
                        <img class="image bell"
                             src="{{ url_for('static', filename='bell.svg') }}"
                             alt=""
                             width="auto"
                             height="auto" />
                    </button>
                    <button id="button-nav-question" class="btn btn-dark" type="button">
                        Ask Question
                    </button>
                    <button id="button-log-out"
                            class="btn btn-dark"
                            type="button"
                            onclick="location.href='/logout';">
                        Log Out
                    </button>
                </div>
                <div id="notification-wrapper" style="display: none;">
                    <div class="notification-center-dimensions notification-background">
                    </div>
                    <div class="notification-center-dimensions">
                        <div class="notification-center">
                            <p class="notifications-title">
                                Notifcations
                            </p>

                            {% for notification in user.notifications | sort(reverse=true, attribute='created_at') %}
                                <div class="notification">
                                    <p class="notification-text">
                                        {{ notification.message }}
                                    </p>
                                    <button class="btn btn-view" type="button">
                                        view
                                    </button>
                                </div>
                            {% endfor %}

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
input#search-box {
    display: none;
    pointer-events: none;
}
</style>
