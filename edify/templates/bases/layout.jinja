<!DOCTYPE html>
<html lang="en">

<head>
	{% block head %}

	<meta charset="utf-8" />
	<title>Edify: {% block title %}{% endblock %}</title>


	{% endblock head %}
		
	<!-- Styles -->
	{% include 'bases/headers.jinja' %}
	
	{% block javascript %}{% endblock %}
</head>


<body>
	<!-- Navbar -->
	{% block navbar %}
	{% endblock %}

	<!-- Top Elements -->
	{% block top %}
	{% endblock %}
	
	<!-- Content -->
	{% block content %}
	{% endblock %}
	
	<!-- Footer -->
	{% block footer %}
		{% include 'bases/footer.jinja' %}
	{% endblock %}
	
</body>

</html>